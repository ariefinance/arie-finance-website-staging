{
  "redirects": [
    {
      "source": "/services",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/team",
      "destination": "/#team",
      "permanent": true
    },
    {
      "source": "/open-account",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/solutions",
      "destination": "/#services",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "/#careers",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/#home",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/legal",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/cookie",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/customer-security",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/faqs",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/cookies",
      "destination": "/#compliance",
      "permanent": true
    },
    {
      "source": "/security",
      "destination": "/#compliance",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/favicon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/og-image.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
