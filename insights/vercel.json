{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/admin", "status": 404 },
    { "src": "/admin/.*", "status": 404 },
    { "src": "/insights/admin", "status": 404 },
    { "src": "/insights/admin/.*", "status": 404 },
    { "src": "/_email-helper\\.html", "status": 404 },
    { "src": "/_email-template\\.html", "status": 404 },
    { "src": "/insights/_email-helper\\.html", "status": 404 },
    { "src": "/insights/_email-template\\.html", "status": 404 },
    { "src": "/_template", "status": 404 },
    { "src": "/_template/.*", "status": 404 },
    { "src": "/insights/_template", "status": 404 },
    { "src": "/insights/_template/.*", "status": 404 },
    { "src": "/PUBLISHING\\.md", "status": 404 },
    { "src": "/ADMIN\\.md", "status": 404 },
    { "src": "/insights/PUBLISHING\\.md", "status": 404 },
    { "src": "/insights/ADMIN\\.md", "status": 404 },
    { "src": "/_articles\\.json", "status": 404 },
    { "src": "/insights/_articles\\.json", "status": 404 },
    { "src": "/insights/(.*)", "dest": "/$1" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
