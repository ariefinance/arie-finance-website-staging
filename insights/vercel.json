{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "/(?:insights/)?admin(?:/.*)?", "dest": "/__blocked__" },
    { "src": "/(?:insights/)?_email-helper\\.html", "dest": "/__blocked__" },
    { "src": "/(?:insights/)?_email-template\\.html", "dest": "/__blocked__" },
    { "src": "/(?:insights/)?_template(?:/.*)?", "dest": "/__blocked__" },
    { "src": "/(?:insights/)?(?:PUBLISHING|ADMIN)\\.md", "dest": "/__blocked__" },
    { "src": "/(?:insights/)?_articles\\.json", "dest": "/__blocked__" },
    { "src": "/insights/(.*)", "dest": "/$1" },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
